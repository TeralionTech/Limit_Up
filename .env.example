# 富邦帳號憑證 (複製這份為 .env 並填實際值)
# .env 不會 commit (在 .gitignore 內)

# === 主帳號 必填 ===
FUBON_ACCOUNT_ID=              # 身份證字號 (或富邦登入帳號)
FUBON_PASSWORD=                # 富邦登入密碼
FUBON_PFX_PATH=                # 憑證絕對路徑 (例: C:/certs/A123456789.pfx)
FUBON_PFX_PASSWORD=            # 憑證密碼 (若無留空即可)

# === 副帳號 選填,最多兩個 (借另一個人的富邦帳號) ===
# 每個帳號富邦上限 5 條 WS;多帳號 = 容量 + 冗餘 (單一帳號憑證掛掉不會少收一半,
# 2026-08-10 教訓)。三帳號建議配置: SOCKET_COUNT=4 / SOCKET_COUNT_2=3 / SOCKET_COUNT_3=3
# → 10 sockets × 199 = 1990 檔全覆蓋,且任一帳號掛掉仍有 ~7 條 (1393 檔)
FUBON_ACCOUNT_ID_2=
FUBON_PASSWORD_2=
FUBON_PFX_PATH_2=
FUBON_PFX_PASSWORD_2=
FUBON_ACCOUNT_ID_3=
FUBON_PASSWORD_3=
FUBON_PFX_PATH_3=
FUBON_PFX_PASSWORD_3=

# === 中心過濾架構 (2026-09-01 上線): ROLE=hub|node|standalone ===
# standalone (預設) = 現行單機自己 filter+trade
# hub  = 只 filter+分發 marked 快照 (08:59:50 凍結),不交易 — 行情帳號放這台
# node = 不 filter;08:59:50 向 Hub 拉 marked 快照 → 只訂那幾檔 (1 socket) → 交易
#   node 必設: ROLE=node + HUB_URL + SOCKET_COUNT=1 + 該台自己的主帳號憑證
ROLE=standalone
HUB_URL=                       # node 用: 例 http://45.76.222.150:8100
HUB_FREEZE_TIME=08:59:50       # hub 凍結 marked 時點 (node 同刻開拉)

# === 可選 (都有預設值) ===
# 監控範圍: twse (只上市) / tpex (只上櫃) / twse+tpex (全部)
UNIVERSE=twse+tpex

# 每批訂閱檔數 (富邦每 WS 上限 200 subs，只訂 books 每檔 1 sub，199 留 1 buffer)
BATCH_SIZE=199

# 每帳號開幾個 WS 連線 (富邦每帳號上限 5)
# SOCKET_COUNT = 主帳號;SOCKET_COUNT_2/_3 = 副帳號各自的條數 (未設 → 同 SOCKET_COUNT)
# 兩帳號: 5+5;三帳號建議 4+3+3 — 都是 10 sockets × 199 = 1990 檔全覆蓋
SOCKET_COUNT=5
#SOCKET_COUNT_2=3
#SOCKET_COUNT_3=3

# 多久切換下一批 (multi-socket 內每 socket 各自 rotate；母體 > 1000 才會 rotate)
BATCH_ROTATE_SEC=30

# 何時停止標記 → 快照輸出
END_TIME=09:00:00

# 漲停價抓取重試截止 — 8:00 開抓後，會對「還沒抓到的股票」反覆重試到此時間為止
# (盤前試撮 8:30 之前留 buffer)，把覆蓋率補齊。
LIMIT_UP_FETCH_DEADLINE=08:28

# 漲停價 REST 抓取節流上限 (檔/分) — 富邦日內行情限 300/min，設 250 留 margin。
# 之前一次狂打 ~900/min 撞限流，導致 1943 檔只成功 746 檔 (後段全被擋)。
LIMIT_UP_MAX_PER_MIN=250

# (deprecated 2026-08-13) 量減半改在 08:59:58 預掛前「一次性批次判」— 8:30 起
# 每 tick 只記錄 max+last,到點比較「最新量 vs 最高量×BID_DROP_RATIO」,此欄不再使用
FINAL_CHECK_START=08:59:00

# 真實模式: 預掛漲停價限價單時點 (集合競價只收限價單，9:00 前掛才排得到開盤撮合)
# final check 減半淘汰的窗口也到此為止 (之後名單凍結、單已掛出)
# 預掛單「不重試」— 精準此時點丟出 (失敗的話 9:00 首筆成交時市價追會救)
PRE_ORDER_TIME=08:59:58

# 市價盲送 (狂送) 開始時點 — 早於 09:00 開盤暖機: 此刻起 cadence 已在跑,集合競價期
# 市價單會被拒→續送,一開盤 (09:00 逐筆) 第一筆最快排到。截止時點超過即停 (靠預掛守)。
MARKET_CHASE_START=08:59:59
MARKET_CHASE_CUTOFF=09:03:00

# 只做漲停價 <= 此價的股票 (0 = 不限制)。超過的不預掛、不市價追。
MAX_STOCK_PRICE=500

# 送單速率上限 (筆/秒) — 富邦 API 明定下單上限 50 request/s，預設 45 留 margin。
# **爆發式**滑動窗口: 一秒內未滿此數就立刻放行 (45 筆可在一秒最前面全部送出，
# 搶 08:59:58 預掛窗口)，滿了才等最舊一筆滑出窗口。進場/出場/撤單共用同一額度。
ORDER_MAX_PER_SEC=45

# 市價追單「失敗後」的單檔退避 (秒) — 只在委託被拒/失敗時等這麼久再試，
# 避免單一失敗標的獨佔共用送單額度。追單重試無上限，直到成功 /
# 該檔淘汰或出場 / CANCEL_PENDING_TIME 到 / kill switch 關。
ORDER_MIN_INTERVAL_SEC=0.2

# 撤掉所有「還沒成交」委託的時點 (持倉不動、留倉)。TRADING_END_TIME=13:24 仍是流程結束點。
CANCEL_PENDING_TIME=13:23:00

# final check 減半閾值 (當下委買一量 < 最大量 × 此比例 → unmark)
BID_DROP_RATIO=0.5

# 開更多 log (每個 tick / 每次 mark event)
DEBUG=false

# === 9:00 後 trader 階段 (做多策略) ===
# 收盤時間 (script 到此時間會平倉所有 SIM 部位 + 結束)
TRADING_END_TIME=13:24:00

# 每檔目標買到幾張就停下單
TARGET_LOTS=5

# 每秒每檔下幾張市價買 (未達 target 時)
ORDER_LOTS_PER_SEC=1

# 買單量連續遞減幾分鐘 → 標記為必須丟棄
BID_DECLINE_MINUTES=5

# 每 N 秒抓一次 bid 五檔總量 sample (預設 60s = 每分鐘一次)
BID_DECLINE_SAMPLE_SEC=60

# ⚠️ 是否跳過 trader 階段 (預設 true = 只跑「篩選 + 常駐收 tick」，不下單)
# 現階段驗證資料流階段建議 true；確認邏輯後才改 false 進 trader
SKIP_TRADER=true
