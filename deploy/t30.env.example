# T30 取檔設定 — 實體放 /opt/hit_limit_up/secrets/t30.env (chmod 600,絕不進 git)
# limit-up VPS --(金鑰)--> 中繼 VPS --(金鑰)--> 券商主機 --(sftp 密碼)--> 檔案主機
# 金鑰: limit-up VPS 的公鑰要同時授權在中繼 VPS 與券商主機

# 中繼 VPS (limit-up VPS 連不到券商主機,要先經過這台;留空 = 直連)
JUMP_HOST=root@45.32.53.219

# 券商提供的主機: user@IP
BROKER_HOST=

# 券商檔案主機 (從券商主機才連得到)
SFTP_HOST=10.83.11.100
SFTP_USER=kc
SFTP_PASS=

# 檔案落地目錄 (limit-up runner 讀這裡;可用 T30_DIR env 覆寫 runner 端)
DEST_DIR=/opt/hit_limit_up/repo/input/t30

# 重試設定 (預設: 每 180 秒重試,最晚到 08:25)
#DEADLINE=08:25
#RETRY_SEC=180
