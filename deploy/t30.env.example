# T30 取檔設定 — 實體放 /opt/hit_limit_up/secrets/t30.env (chmod 600,絕不進 git)
# VPS --(ssh 金鑰,免密碼)--> 券商主機 --(sftp 密碼)--> 券商檔案主機

# 券商提供的主機 (VPS 已設好 ssh 金鑰): user@IP
BROKER_HOST=

# 券商檔案主機 (從券商主機才連得到)
SFTP_HOST=10.83.11.100
SFTP_USER=kc
SFTP_PASS=

# 檔案落地目錄 (limit-up runner 讀這裡;可用 T30_DIR env 覆寫 runner 端)
DEST_DIR=/opt/hit_limit_up/repo/input/t30

# 重試設定 (預設: 每 180 秒重試,最晚到 08:25)
#DEADLINE=08:25
#RETRY_SEC=180
